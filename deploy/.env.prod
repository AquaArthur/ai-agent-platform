PROJECT_NAME=ai-agent-platform

# ============================
# MySQL 数据库（生产环境）
# ============================
MYSQL_PORT=3306
MYSQL_DATABASE=ai_agent_platform_db
# 请在实际部署前修改为强密码
MYSQL_ROOT_PASSWORD=123456
TZ=Asia/Shanghai

# phpMyAdmin（生产环境，仅在 --with-admin 时使用）
PHPMYADMIN_PORT=8081

# ============================
# 后端 / 前端 / KB 端口（生产）
# 与开发环境端口不冲突
# ============================
BACKEND_PORT=8080
WEB_ADMIN_PORT=80
KB_PORT=9000

# ============================
# 应用级配置（生产）
# ============================
SPRING_PROFILES_ACTIVE=prod
DEBUG=false
LOG_LEVEL=info
ENABLE_SWAGGER=false
NODE_ENV=production
KB_ENV=production
